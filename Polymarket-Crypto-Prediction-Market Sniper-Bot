Kelly Criterion sizing:
def calculate_position_size(confidence, bankroll, sell_price_estimate):
    p = 0.50 + (confidence - 5) * 0.05  # Map confidence 5-10 to p 0.50-0.75
    q = 1 - p
    b = sell_price_estimate / (1 - sell_price_estimate)
    kelly_fraction = (b * p - q) / b
    kelly_fraction = max(0, min(kelly_fraction, 0.25))  # Cap at 25%
    
    # Use quarter-Kelly for safety
    position_size = bankroll * ACTIVE_POOL_RATIO * kelly_fraction * 0.25
    position_size = max(1, round(position_size))  # Minimum 1 token (API minimum)
    return position_size
